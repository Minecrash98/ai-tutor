DATABASE_URL=postgresql://postgres:ai_tutor_local@127.0.0.1:5432/ai_tutor
POSTGRES_PASSWORD=replace-with-a-local-secret
AI_TUTOR_REALTIME_MODEL=gpt-live-1-codex
AI_TUTOR_TEXT_REALTIME_MODEL=gpt-realtime

# Optional host integrations
# CODEX_APP_SERVER_BINARY=C:\path\to\codex.exe
# AI_TUTOR_LOG_DIR=F:\path\to\ai-tutor-logs

# Isolated test-only switches; never point fake-audio tests at a physical mic.
# AI_TUTOR_LIVE_REALTIME=0
# AI_TUTOR_FAKE_AUDIO_CAPTURE=F:\path\to\synthetic-audio.wav
# AI_TUTOR_VOICE_LATENCY_ONLY=0
# AI_TUTOR_P7_DATABASE=0
# AI_TUTOR_TEST_DATABASE_URL=postgresql://postgres:secret@127.0.0.1:5432/ai_tutor_test
# AI_TUTOR_SOAK_DURATION_MS=1800000
